{
  "name": "awtomatig-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AWTOMATIG API: CMS and ERP modules (modular monolith)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . && npm run check:boundaries && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "openapi:export": "nest build && node dist/openapi-export.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "fastify": "^5.12.7"
  }
}
