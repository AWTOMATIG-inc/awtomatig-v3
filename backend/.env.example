# Copy to .env. Every value is validated at boot (src/shared/config/env.ts); the app refuses to start on a bad or missing one.

NODE_ENV=development

# Bind to localhost; Nginx is the only thing that faces the internet.
HOST=127.0.0.1
PORT=4000

# Set to true when the app runs behind Nginx so the real client IP is used (rate limiting, logs).
TRUST_PROXY=false

# PostgreSQL (the local docker-compose.dev.yml uses these values).
DATABASE_URL=postgres://awtomatig:awtomatig@localhost:5432/awtomatig
DATABASE_POOL_MAX=10

# Comma-separated list of browser origins allowed to call the API (frontend and admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication (Better Auth). Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# BETTER_AUTH_URL is the public origin of the admin app, because the browser calls /api on that origin.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# Shared secret between the website's server and this API: only a request that sends it (x-ingest-key) can add a lead.
# The website's .env needs the same value as LEAD_INGEST_KEY. Generate one like BETTER_AUTH_SECRET above.
LEAD_INGEST_KEY=replace-with-at-least-32-random-characters

# Only for `npm run seed:admin`: the first administrator. Leave unset otherwise, and remove the password after seeding.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_PASSWORD=at-least-12-characters

# Requests per minute per client IP.
RATE_LIMIT_MAX=120

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
