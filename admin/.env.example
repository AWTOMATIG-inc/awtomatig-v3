# Copy to .env. Server-only values are read at runtime, except API_URL, which next.config.ts reads at build time
# for the /api rewrite, so rebuild after changing it. NEXT_PUBLIC_* values are baked in at `npm run build`.

# The backend API. The browser never calls it directly: Next.js rewrites /api/* to it, so the session cookie stays same-origin.
API_URL=http://127.0.0.1:4000

# Timezone used to format dates and times everywhere (an IANA name). Defaults to UTC.
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka
