# Copy to .env. Server-only values are read at runtime, except API_URL, which next.config.ts reads at build time
# for the /api rewrite, so rebuild after changing it. NEXT_PUBLIC_* values are baked in at `npm run build`.

# The backend API. Required: the app will not start or build without it (there is no default in the code). The browser never
# calls it directly: Next.js rewrites /api/* to it, so the session cookie stays same-origin. Locally and on the VPS the backend
# runs on the same machine, so http://127.0.0.1:4000; set whatever address the backend has where you run the admin.
API_URL=http://127.0.0.1:4000

# Timezone used to format dates and times everywhere (an IANA name). Defaults to UTC.
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka
