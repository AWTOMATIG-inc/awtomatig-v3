# Copy to .env. Server-only values are read at runtime, except API_URL, which next.config.ts reads at build time
# for the /api rewrite, so rebuild after changing it. NEXT_PUBLIC_* values are baked in at `npm run build`.

# The backend API. Required: the app will not start or build without it (there is no default in the code). The browser never
# calls it directly: Next.js rewrites /api/* to it, so the session cookie stays same-origin. Locally and on the VPS the backend
# runs on the same machine, so http://127.0.0.1:4000; set whatever address the backend has where you run the admin.
API_URL=http://127.0.0.1:4000

# The public address of the website's image bucket, the same value as R2_PUBLIC_BASE_URL in the backend's .env. Case study images are
# shown from there, so the production CSP allows this one origin for images. Required in production (build and start); not needed for
# `next dev`, which has no CSP. Read at build time, so rebuild after changing it.
ASSETS_URL=https://pub-xxxxxxxx.r2.dev

# Timezone used to format dates and times everywhere (an IANA name). Defaults to UTC.
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka

# The public website's address, used for the "Open" and "Share link" buttons on the job openings list. Not a secret. Baked in at build
# time. Defaults to https://awtomatig.com; use http://localhost:3000 for local work.
NEXT_PUBLIC_WEBSITE_URL=https://awtomatig.com

# Google Analytics 4 (the Analytics page). Server-only and secret: never prefix with NEXT_PUBLIC_. GA_PROPERTY_ID is the numeric
# property id (Analytics > Admin > Property details). The service account (GA_CLIENT_EMAIL) must be added to that property as a
# Viewer, and the "Google Analytics Data API" must be enabled in its Google Cloud project. GA_PRIVATE_KEY is the key from the JSON file;
# keep it in quotes, either multi-line or on one line with \n. GA_MEASUREMENT_ID is the website's G-... tag id (not used here).
GA_PROPERTY_ID=123456789
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_CLIENT_EMAIL=reporting@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
