# Copy to .env on the server. NEXT_PUBLIC_* values are baked in at `npm run build`, so rebuild after changing them.

# Google Tag Manager container (loads GA4 and Microsoft Clarity). Only loaded in production builds; leave empty to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: the site's public URL (canonical, sitemap, Open Graph). Defaults to https://www.awtomatig.com.
# NEXT_PUBLIC_SITE_URL=https://www.awtomatig.com

# Contact form mail, server-only (never NEXT_PUBLIC_). Gmail / Google Workspace SMTP with an app password
# (Google Account → Security → App passwords). CONTACT_TO is a comma-separated list of recipients.
# The form emails the team (CONTACT_TO) and sends the visitor a confirmation from this mailbox.
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Contact form leads, server-only (never NEXT_PUBLIC_). The form also saves each inquiry in the CRM so the team sees it in the
# admin dashboard. CRM_API_URL is the backend's address as the website's server reaches it (same VPS: http://127.0.0.1:4000).
# LEAD_INGEST_KEY must equal LEAD_INGEST_KEY in backend/.env. Leave both empty to only send the emails (no CRM record).
CRM_API_URL=
LEAD_INGEST_KEY=
